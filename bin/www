#!/usr/bin/env node

var app = require('../app');
var ymaps = require('../lib/ymaps');
var tls = require('../lib/tls');
var debug = require('debug')('headless-ymaps:server');
var http = require('http');
var https = require('https');

if (!process.env.ACCESSAPIKEY) {
  console.error('Не задана переменная окружения ACCESSAPIKEY');
  process.exit(1);
}

var port = normalizePort(process.env.PORT || '8080');
app.set('port', port);

var server = createServer();

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

// Браузер и API Карт загружаются заранее, чтобы первый запрос не ждал.
ymaps.getPage().catch(function (err) {
  console.error('Не удалось загрузить API Карт, повторим при первом запросе:', err.message);
});

process.on('SIGTERM', shutdown);
process.on('SIGINT', shutdown);

// HTTPS, если есть ключ и сертификат, иначе HTTP.
function createServer() {
  if (tls.isTlsEnabled()) {
    try {
      return https.createServer(tls.tlsOptions(), app);
    } catch (err) {
      console.error('Не удалось загрузить TLS-ключ или сертификат (' + err.code + '): ' + err.message);
      if (err.code === 'EACCES') {
        console.error('Процесс работает от uid ' + process.getuid() + ', у него должно быть право на чтение файлов');
      }
      process.exit(1);
    }
  }

  var paths = tls.tlsPaths();
  console.warn('Файлы ' + paths.key + ' и ' + paths.cert + ' не найдены, сервер работает по HTTP');
  return http.createServer(app);
}

function shutdown() {
  server.close();
  ymaps.close().finally(function () {
    process.exit(0);
  });
}

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    return val;
  }

  if (port >= 0) {
    return port;
  }

  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  console.log('Listening on ' + bind);
  debug('Listening on ' + bind);
}
