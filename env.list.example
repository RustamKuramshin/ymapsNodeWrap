# Скопируйте в env.list и заполните. Файл env.list не должен попадать в git.
# В docker compose порт внутри контейнера всегда 8080, внешний задаётся HOST_PORT.
PORT=8080
# Ключ, который клиенты передают в параметре apikey (обязателен).
ACCESSAPIKEY=
# Ключ JavaScript API Яндекс.Карт (developer.tech.yandex.ru).
YANDEXAPIKEY=
# Пути к TLS-ключу и сертификату. Если файлов нет, сервер поднимается по HTTP.
TLS_KEY=key.pem
TLS_CERT=cert.pem
# Пароль к TLS-ключу, если он зашифрован.
PASSPHRASE=
# Таймаут построения одного маршрута, мс.
ROUTE_TIMEOUT_MS=15000
